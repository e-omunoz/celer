{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Celer",
  "version": "2.2.0",
  "identifier": "es.celer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Celer",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Swift SQL for every database",
    "longDescription": "Celer is a fast desktop SQL client for PostgreSQL, MySQL/MariaDB, SQL Server, SQLite, Informix and ODBC.",
    "publisher": "Celer",
    "copyright": "Copyright (c) Celer contributors",
    "category": "DeveloperTool",
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "wix": { "language": "es-ES" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
